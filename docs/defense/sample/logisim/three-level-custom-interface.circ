<?xml version="1.0" encoding="UTF-8"?>
<project source="2.7.1" version="1.0">
    <!--Standard Logisim 2.7.1 components and Tunnel networks. Layout is rebuilt. Pin interactive values reset according to Logisim project semantics.-->
